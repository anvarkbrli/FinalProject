{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "Steam": {
    "Enabled": false,
    "ApiKey": "",
    "WebApiBaseUrl": "https://api.steampowered.com/",
    "StorefrontBaseUrl": "https://store.steampowered.com/api/",
    "OpenIdEndpoint": "https://steamcommunity.com/openid/login",
    "OpenIdRealm": "https://localhost:7286/",
    "OpenIdCallbackUrl": "https://localhost:7286/api/settings/export/steam/callback",
    "FrontendSettingsUrl": "http://localhost:5173/settings?section=export",
    "FrontendOrigin": "http://localhost:5173",
    "CountryCode": "AZ",
    "Language": "english",
    "RequestTimeoutSeconds": 30,
    "RequestsPerMinute": 90,
    "MaxConcurrentRequests": 4,
    "RetryCount": 3,
    "LinkStateLifetimeMinutes": 10,
    "ProfileCacheSeconds": 15,
    "AchievementSchemaCacheMinutes": 360,
    "ComingSoonCacheMinutes": 30
  },
  "FileStorageSettings": {
    "WebRootPath": "wwwroot",
    "PrivateStoragePath": "private-storage"
  },
  "MalwareScanning": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 3310,
    "TimeoutSeconds": 15,
    "ChunkSizeBytes": 65536,
    "FailClosed": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": [],
    "AllowedHosts": []
  },
  "DataProtection": {
    "ApplicationName": "WellPlayd",
    "KeyRingPath": "data-protection-keys"
  },
  "Cache": {
    "RedisEnabled": false,
    "RedisConnectionString": "",
    "InstanceName": "wellplayd:dev:",
    "LocalFallbackSeconds": 30
  },
  "Presence": {
    "UseDistributedStore": false,
    "HeartbeatSeconds": 20,
    "OfflineAfterSeconds": 90
  },
  "SqlIdleMode": {
    "Enabled": false
  }
}
