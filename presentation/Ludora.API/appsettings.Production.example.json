{
  "ConnectionStrings": {
    "default": "Server=sqlserver;Database=WellPlayd;User Id=sa;Password=<SET_WITH_ENVIRONMENT_VARIABLE>;Encrypt=true;TrustServerCertificate=true"
  },
  "JwtSettings": {
    "Key": "<SET_WITH_JwtSettings__Key>",
    "Issuer": "WellPlayd.API",
    "Audience": "WellPlayd.Client",
    "ExpiresInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://wellplayd.example"
    ]
  },
  "AllowedHosts": "api.wellplayd.example",
  "ForwardedHeaders": {
    "Enabled": true,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": [
      "172.28.0.0/16"
    ],
    "AllowedHosts": [
      "api.wellplayd.example"
    ]
  },
  "FileStorageSettings": {
    "WebRootPath": "/data/wellplayd/public",
    "PrivateStoragePath": "/data/wellplayd/private"
  },
  "MalwareScanning": {
    "Enabled": true,
    "Host": "clamav",
    "Port": 3310,
    "TimeoutSeconds": 30,
    "ChunkSizeBytes": 65536,
    "FailClosed": true
  },
  "EmailSettings": {
    "Enabled": true,
    "Host": "smtp.example.com",
    "Port": 587,
    "UserName": "<SET_WITH_EmailSettings__UserName>",
    "Password": "<SET_WITH_EmailSettings__Password>",
    "FromEmail": "support@wellplayd.example",
    "FromName": "WellPlayd",
    "EnableSsl": true,
    "PublicApiBaseUrl": "https://api.wellplayd.example",
    "PublicFrontendBaseUrl": "https://wellplayd.example",
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "SendTimeoutSeconds": 30
  },
  "DataProtection": {
    "ApplicationName": "WellPlayd",
    "KeyRingPath": "/data/wellplayd/data-protection-keys"
  },
  "Cache": {
    "RedisEnabled": true,
    "RedisConnectionString": "redis:6379,abortConnect=false",
    "InstanceName": "wellplayd:prod:",
    "LocalFallbackSeconds": 30
  },
  "Authentication": {
    "Google": {
      "Enabled": true,
      "ClientId": "<SET_WITH_Authentication__Google__ClientId>",
      "ClientSecret": "<SET_WITH_Authentication__Google__ClientSecret>",
      "CallbackPath": "/signin-google",
      "FrontendCallbackUrl": "https://wellplayd.example/auth/google/callback",
      "TicketLifetimeMinutes": 10
    }
  },
  "Presence": {
    "UseDistributedStore": true,
    "HeartbeatSeconds": 20,
    "OfflineAfterSeconds": 90
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "SqlIdleMode": {
    "Enabled": true
  }
}
