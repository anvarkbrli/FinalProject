{
  "name": "wellplayd-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-frontend.mjs",
    "dev": "vite",
    "clean": "node scripts/clean-build-output.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.mjs && node scripts/build-auto-locales.mjs --check",
    "i18n:generate": "node scripts/build-auto-locales.mjs",
    "verify": "npm run lint && npm run i18n:check && npm run typecheck",
    "build": "node scripts/validate-production-env.mjs && tsc -b && vite build",
    "build:clean": "npm run clean && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@microsoft/signalr": "^8.0.17",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2"
}
