# Copy this file to deployment/.env.production and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=wellplayd
IMAGE_TAG=2026.08.05
API_IMAGE=wellplayd-api
FRONTEND_IMAGE=wellplayd-frontend

# The container is bound to localhost by default. Put Caddy/Nginx/Traefik with TLS in front of it.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=8080
PUBLIC_FRONTEND_ORIGIN=https://wellplayd.az
PUBLIC_API_BASE_URL=https://wellplayd.az
API_ALLOWED_HOSTS=wellplayd.az
DOCKER_SUBNET=172.28.0.0/16

DB_NAME=WellPlayd
MSSQL_PID=Express
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_SQL_PASSWORD

JWT_SIGNING_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG
JWT_ISSUER=WellPlayd.API
JWT_AUDIENCE=WellPlayd.Client
JWT_EXPIRES_MINUTES=60
REDIS_INSTANCE_NAME=wellplayd:prod:

SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=support@wellplayd.az
SMTP_FROM_NAME=WellPlayd
SMTP_ENABLE_SSL=true

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

IGDB_ENABLED=false
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

STEAM_ENABLED=false
STEAM_API_KEY=

FPS_RESEARCH_ENABLED=false
FPS_RESEARCH_API_KEY=

TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_REGION=

# Optional override used by deployment/scripts/smoke-test.sh before public DNS/TLS is active.
# Local container endpoint; the smoke script supplies the production Host and HTTPS forwarded headers.
SMOKE_BASE_URL=http://127.0.0.1:8080
